# OSS-13 (v1.207.0) — okolje zabojnika. Kopiraj v deploy/.env in izpolni.
#   cp deploy/.env.example deploy/.env
# Kontrakt: src/lib/selfhost-kit.ts (validateEnvExampleContract).
#
# POMEMBNO: identiteta obrata gre v zabojnik PREK OKOLJA — brez TLS fronte
# čarovnik /setup v zabojniku ne more prevzeti namestitve (dokaz računa fronta).
# Prvi zagon = izpolni spodnja polja in (ponovno) zaženi storitev.

# Ime obrata (prikaz v aplikaciji, računi)
RESTAURANTOS_NAME=""

# Prijavni e-poštni naslov lastnika (prvi zagon)
RESTAURANTOS_OWNER_EMAIL=""

# PIN lastnika, 4–8 števk (prvi zagon; po prijavi ga lahko spremeniš v nastavitvah)
RESTAURANTOS_OWNER_PIN=""

# Davčna številka obrata — SI: 8 števk s kontrolno, HR: OIB 11 števk (ali prazno)
RESTAURANTOS_TAX_ID=""

# Matična številka obrata (opcijsko)
RESTAURANTOS_BUSINESS_ID=""

# Zunanja vrata gostitelja (privzeto 3000; spremeni, če je zasedena)
RESTAURANTOS_PORT=3000

# ── Opcijske integracije ────────────────────────────────────────────────────
# Fiskalizacija (SI/HR), Stripe, SMTP, Upstash … ključi so opisani v korenskem
# .env.example repozitorija. V zabojnik jih preneseš z `environment:` v
# deploy/docker-compose.yml (ali svojo env_file datoteko) — skrivnosti NIKOLI
# v repozitorij in NIKOLI v to datoteko, če jo zavežeš.
