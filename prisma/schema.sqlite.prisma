// RestavrantOS — LOKALNA SQLite zrcalna shema (AVTOMATSKO generirana)
// Iz prisma/schema.prisma (produkcijska Neon Postgres shema, 110 modelov).
// Ponovno generiraj: python3 scripts/build-sqlite-mirror.py
// Razlike od produkcije: Json -> String (SQLite ne podpira Json), enumi -> String.
// Aplikacijska koda je združljiva z obema (jparse/jstr helperji v src/lib/map.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AIConversation {
  id             String   @id
  type           String
  userMessage    String
  aiResponse     String
  model          String   @default("gemini-2.0-flash")
  tokensUsed     Int      @default(0)
  responseTimeMs Int      @default(0)
  employeeId     String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([employeeId])
  @@index([type])
}

model AccountsPayable {
  id                  String                @id
  apNumber            String                @unique
  supplierId          String
  purchaseOrderId     String?
  invoiceNumber       String                @default("")
  invoiceDate         DateTime              @default(now())
  dueDate             DateTime
  subtotal            Decimal
  vatAmount           Decimal               @default(0)
  totalAmount         Decimal               
  paidAmount          Decimal               @default(0) 
  status              String                @default("open")
  paidAt              DateTime?
  notes               String                @default("")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime @updatedAt
  locationId          String?
  matchStatus         String                @default("unmatched")
  Location            Location?             @relation(fields: [locationId], references: [id], onUpdate: SetNull)
  Supplier            Supplier              @relation(fields: [supplierId], references: [id])
  AccountsPayableLine AccountsPayableLine[]

  @@index([dueDate])
  @@index([locationId])
  @@index([status, dueDate])
  @@index([status])
  @@index([supplierId])
}

model AccountsPayableLine {
  id                  String             @id
  accountsPayableId   String
  purchaseOrderItemId String?
  description         String
  quantityInvoiced    Decimal            @default(0) 
  unitPriceInvoiced   Decimal            @default(0) 
  vatRateInvoiced     Decimal?           
  lineTotal           Decimal            @default(0) 
  varianceStatus      String             @default("match")
  varianceNote        String             @default("")
  createdAt           DateTime           @default(now())
  AccountsPayable     AccountsPayable    @relation(fields: [accountsPayableId], references: [id], onDelete: Cascade)
  PurchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([accountsPayableId])
  @@index([purchaseOrderItemId])
}

model AccountsReceivable {
  id            String    @id
  arNumber      String    @unique
  orderId       String?
  guestId       String?
  customerName  String
  customerTaxId String    @default("")
  customerEmail String    @default("")
  invoiceNumber String    @default("")
  invoiceDate   DateTime  @default(now())
  dueDate       DateTime
  subtotal      Decimal
  vatAmount     Decimal   @default(0)
  totalAmount   Decimal
  paidAmount    Decimal   @default(0) 
  status        String    @default("open")
  paidAt        DateTime?
  notes         String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime @updatedAt
  locationId    String?
  Location      Location? @relation(fields: [locationId], references: [id], onUpdate: SetNull)

  @@index([customerTaxId])
  @@index([dueDate])
  @@index([locationId])
  @@index([status, dueDate])
  @@index([status])
}

model AlternatePaymentType {
  id         String    @id
  name       String
  code       String    @default("")
  type       String    @default("voucher")
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime @updatedAt
  locationId String
  Location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  Payment    Payment[]

  @@index([isActive])
  @@index([locationId])
  @@index([type])
}

model ApiKey {
  id             String       @id
  subscriptionId String
  name           String
  keyPrefix      String
  keyHash        String       @unique
  rateLimit      Int          @default(60)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdBy      String?
  scopes         String         @default("[]")
  Subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([isActive])
  @@index([keyHash])
  @@index([subscriptionId])
}

model AuditLog {
  id           String   @id
  timestamp    DateTime @default(now())
  userId       String?
  action       String
  entityType   String
  entityId     String?
  details      String   @default("{}")
  ipAddress    String   @default("")
  terminalId   String?
  previousHash String   @default("")
  chainHash    String   @default("")
  locationId   String?

  @@index([action])
  @@index([entityType, entityId])
  @@index([locationId])
  @@index([timestamp])
  @@index([userId])
}

model BatchPreparation {
  id                       String                 @id
  locationId               String
  status                   String                 @default("DRAFT")
  outputItemId             String
  outputQuantity           Decimal                
  outputUnit               String                 @default("")
  outputCostPerUnit        Decimal                @default(0) 
  totalInputCost           Decimal                @default(0) 
  note                     String                 @default("")
  createdByName            String                 @default("")
  completedByName          String                 @default("")
  completedAt              DateTime?
  cancelledAt              DateTime?
  idempotencyKey           String?
  outputStockTransactionId String?                @unique
  createdAt                DateTime               @default(now())
  updatedAt                DateTime @updatedAt
  Location                 Location               @relation(fields: [locationId], references: [id])
  InventoryItem            InventoryItem          @relation(fields: [outputItemId], references: [id], onUpdate: Restrict)
  StockTransaction         StockTransaction?      @relation(fields: [outputStockTransactionId], references: [id], onUpdate: SetNull)
  BatchPreparationLine     BatchPreparationLine[]

  @@unique([locationId, idempotencyKey])
  @@index([idempotencyKey])
  @@index([locationId, createdAt])
  @@index([outputItemId])
  @@index([status])
}

model BatchPreparationLine {
  id                      String            @id
  preparationId           String
  inventoryItemId         String
  itemName                String            @default("")
  unit                    String            @default("")
  quantity                Decimal           
  costPerUnit             Decimal           
  inputStockTransactionId String?           @unique
  createdAt               DateTime          @default(now())
  updatedAt               DateTime @updatedAt
  StockTransaction        StockTransaction? @relation(fields: [inputStockTransactionId], references: [id], onUpdate: SetNull)
  InventoryItem           InventoryItem     @relation(fields: [inventoryItemId], references: [id], onUpdate: Restrict)
  BatchPreparation        BatchPreparation  @relation(fields: [preparationId], references: [id], onDelete: Cascade)

  @@unique([preparationId, inventoryItemId])
  @@index([inventoryItemId])
}

model BiometricCredential {
  id           String    @id
  credentialId String    @unique
  employeeId   String
  publicKey    String
  counter      Int       @default(0)
  deviceType   String    @default("")
  backed       Boolean   @default(false)
  nickname     String    @default("")
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime @updatedAt
  transports   String      @default("[]")
  Employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@index([employeeId])
}

model BlockchainAuditEntry {
  id           String   @id
  blockNumber  Int      @unique
  previousHash String
  currentHash  String
  entityType   String
  entityId     String
  action       String
  payload      String
  signature    String   @default("")
  timestamp    DateTime @default(now())
  minerId      String?

  @@index([blockNumber])
  @@index([currentHash])
  @@index([entityType, entityId])
  @@index([timestamp])
}

model CarbonFactor {
  id         String   @id
  name       String
  category   String   @default("ingredient")
  co2ePerKg  Decimal
  unit       String   @default("kg")
  source     String   @default("Agribalyse")
  waterUsage Decimal?
  landUse    Decimal?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([name, category])
  @@index([category])
  @@index([isActive])
}

model CashRegisterShift {
  id             String    @id
  employeeId     String?
  employeeName   String    @default("")
  status         String    @default("open")
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  startingCash   Decimal   @default(0)
  closingCash    Decimal   @default(0) 
  expectedCash   Decimal   @default(0) 
  cashSales      Decimal   @default(0)
  cardSales      Decimal   @default(0)
  mobileSales    Decimal   @default(0)
  alternateSales Decimal   @default(0)
  splitPayments  Decimal   @default(0) 
  totalSales     Decimal   @default(0) 
  totalOrders    Int       @default(0)
  totalDiscounts Decimal   @default(0) 
  totalTips      Decimal   @default(0) 
  totalVoided    Decimal   @default(0) 
  cashDifference Decimal   @default(0) 
  notes          String    @default("")
  locationId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime @updatedAt
  totalRefunds   Decimal   @default(0) 
  Employee       Employee? @relation(fields: [employeeId], references: [id], onUpdate: SetNull)
  Location       Location? @relation(fields: [locationId], references: [id], onUpdate: SetNull)

  @@index([closedAt])
  @@index([employeeId])
  @@index([locationId])
  @@index([openedAt])
  @@index([status])
}

model Category {
  id        String     @id
  name      String
  icon      String     @default("🍽️")
  color     String     @default("#f59e0b")
  sortOrder Int        @default(0)
  menuId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime @updatedAt
  Menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  MenuItem  MenuItem[]

  @@unique([name, menuId])
  @@index([menuId])
}

model ChartOfAccount {
  id                   String           @id
  code                 String           @unique
  name                 String
  parentId             String?
  isActive             Boolean          @default(true)
  description          String           @default("")
  sortOrder            Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime @updatedAt
  accountType          String
  ChartOfAccount       ChartOfAccount?  @relation("ChartOfAccountToChartOfAccount", fields: [parentId], references: [id])
  other_ChartOfAccount ChartOfAccount[] @relation("ChartOfAccountToChartOfAccount")
  JournalLine          JournalLine[]

  @@index([accountType])
  @@index([isActive])
  @@index([parentId])
}

model Check {
  id                String        @id
  checkNumber       Int
  orderId           String
  subtotal          Decimal       @default(0) 
  tax               Decimal       @default(0) 
  discount          Decimal       @default(0) 
  serviceCharge     Decimal       @default(0) 
  total             Decimal       @default(0) 
  tip               Decimal       @default(0) 
  totalWithTip      Decimal       @default(0) 
  paymentStatus     String @default("unpaid")
  paymentMethod     String        @default("")
  appliedDiscountId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime @updatedAt
  Discount          Discount?     @relation(fields: [appliedDiscountId], references: [id], onUpdate: SetNull)
  Order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  OrderItem         OrderItem[]
  Payment           Payment[]

  @@unique([orderId, checkNumber])
  @@index([appliedDiscountId])
  @@index([orderId])
  @@index([paymentStatus])
  @@index([paymentStatus, orderId])
}

model Counter {
  id    String @id
  name  String @unique
  value Int    @default(0)
}

model Course {
  id           String      @id
  orderId      String
  courseNumber Int         @default(1)
  name         String      @default("")
  status       String      @default("pending")
  firedAt      DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  pacingNote   String      @default("")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime @updatedAt
  Order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  OrderItem    OrderItem[]

  @@index([orderId])
  @@index([orderId, status])
  @@index([status])
}

model DailyClose {
  id                String    @id
  locationId        String
  businessDate      DateTime
  status            String    @default("PENDING_APPROVAL")
  expectedCash      Decimal   @default(0) 
  countedCash       Decimal   @default(0) 
  cashVariance      Decimal   @default(0) 
  varianceThreshold Decimal   @default(0) 
  totalSales        Decimal   @default(0) 
  cashSales         Decimal   @default(0) 
  cardSales         Decimal   @default(0) 
  mobileSales       Decimal   @default(0) 
  alternateSales    Decimal   @default(0) 
  totalOrders       Int       @default(0)
  totalDiscounts    Decimal   @default(0) 
  totalTips         Decimal   @default(0) 
  totalVoided       Decimal   @default(0) 
  totalRefunds      Decimal   @default(0) 
  closedById        String?
  closedByName      String    @default("")
  closedAt          DateTime?
  approvedById      String?
  approvedByName    String    @default("")
  approvedAt        DateTime?
  approvalNote      String    @default("")
  rejectedNote      String    @default("")
  reopenCount       Int       @default(0)
  reopenedById      String?
  reopenedByName    String    @default("")
  reopenedAt        DateTime?
  reopenReason      String    @default("")
  notes             String    @default("")
  zReportId         String?
  idempotencyKey    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime @updatedAt
  Location          Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, businessDate])
  @@unique([locationId, idempotencyKey])
  @@index([businessDate])
  @@index([closedAt])
  @@index([status])
}

model DeliveryInfo {
  id                   String    @id
  address              String
  city                 String    @default("")
  postCode             String    @default("")
  recipientName        String    @default("")
  recipientPhone       String    @default("")
  deliveryInstructions String    @default("")
  promisedTime         DateTime?
  estimatedTime        DateTime?
  actualTime           DateTime?
  courierName          String    @default("")
  courierPhone         String    @default("")
  status               String    @default("pending")
  packagingFee         Decimal   @default(0) 
  deliveryFee          Decimal   @default(0) 
  latitude             Float?
  longitude            Float?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime @updatedAt
  Order                Order?

  @@index([status])
}

model DeliveryTracking {
  id               String    @id
  deliveryInfoId   String    @unique
  driverName       String    @default("")
  driverPhone      String    @default("")
  vehicleInfo      String    @default("")
  currentLat       Float?
  currentLng       Float?
  lastUpdateAt     DateTime?
  status           String    @default("assigned")
  estimatedArrival DateTime?
  assignedAt       DateTime?
  pickedUpAt       DateTime?
  onTheWayAt       DateTime?
  deliveredAt      DateTime?
  customerRating   Int?
  customerFeedback String    @default("")
  locationId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime @updatedAt
  driverEmployeeId String?
  podNotes         String?
  Employee         Employee? @relation(fields: [driverEmployeeId], references: [id])
  Location         Location? @relation(fields: [locationId], references: [id], onUpdate: SetNull)

  @@index([deliveryInfoId])
  @@index([driverEmployeeId])
  @@index([driverName])
  @@index([estimatedArrival])
  @@index([locationId])
  @@index([status])
}

model DeliveryZone {
  id                String    @id
  name              String
  radiusKm          Float?
  centerLat         Float?
  centerLng         Float?
  deliveryFee       Decimal   @default(2.50)
  minOrderAmount    Decimal   @default(10.00)
  freeDeliveryAbove Decimal   @default(0)
  estimatedMinutes  Int       @default(30)
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  locationId        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime @updatedAt
  postCodes         String      @default("[]")
  cities            String      @default("[]")
  Location          Location? @relation(fields: [locationId], references: [id], onUpdate: SetNull)

  @@index([isActive])
  @@index([locationId])
}

model DeviceRegistry {
  id         String    @id
  deviceId   String    @unique
  name       String
  locationId String?
  type       String    @default("pos")
  status     String    @default("offline")
  lastSeenAt DateTime?
  appVersion String    @default("")
  // Issue #3: CFD pairing + display state + revoke
  pairingCode      String?
  pairingExpiresAt DateTime?
  pairedToDeviceId String?
  displayPayload   String?
  displayUpdatedAt DateTime?
  revokedAt        DateTime?
  // Issue #4 §2.2: one-time enrollment code ( kratka veljavnost, enkratna uporaba)
  enrollmentCode       String?
  enrollmentExpiresAt  DateTime?
  enrollmentClaimedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime @updatedAt
  Location   Location? @relation(fields: [locationId], references: [id], onUpdate: SetNull)

  @@index([locationId])
  @@index([status])
  @@index([enrollmentCode])
}

model DeviceSyncOperation {
  id                String    @id
  deviceId          String
  locationId        String
  clientOperationId String
  operationType     String
  payload           String?
  clientRetryCount  Int       @default(0)
  status            String    @default("applied")
  orderId           String?
  ack               String?
  lastError         String?
  employeeId        String?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
  Location          Location  @relation(fields: [locationId], references: [id])

  @@unique([deviceId, clientOperationId])
  @@index([deviceId, receivedAt])
  @@index([locationId, receivedAt])
  @@index([status, receivedAt])
}

model DiningOption {
  id              String         @id
  name            String
  type            String
  serviceChargeId String?
  prepTimeMinutes Int            @default(15)
  taxRateId       String?
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime @updatedAt
  locationId      String
  Location        Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ServiceCharge   ServiceCharge? @relation(fields: [serviceChargeId], references: [id], onUpdate: SetNull)
  TaxRate         TaxRate?       @relation(fields: [taxRateId], references: [id], onUpdate: SetNull)
  Order           Order[]

  @@unique([type, locationId])
  @@index([isActive])
  @@index([locationId])
  @@index([serviceChargeId])
}

model Discount {
  id          String      @id
  name        String
  type        String
  amount      Decimal     
  appliesTo   String      @default("check")
  triggerType String      @default("manual")
  promoCode   String      @default("")
  maxUses     Int?
  currentUses Int         @default(0)
  validFrom   DateTime?
  validTo     DateTime?
  // Issue #1 §6: Happy Hour — časovna okna po dnevih/urah + ciljni kategoriji (CSV, prazno = cel račun)
  happyDays        String   @default("")
  happyFromHour    Int?
  happyToHour      Int?
  targetCategoryIds String  @default("")
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime @updatedAt
  locationId  String
  Check       Check[]
  Location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  OrderItem   OrderItem[]

  @@index([isActive])
  @@index([locationId])
  @@index([promoCode])
  @@index([triggerType])
}

model Employee {
  id                                                  String                @id
  name                                                String
  email                                               String                @unique
  phone                                               String                @default("")
  role                                                String          @default("staff")
  status                                              String        @default("active")
  hireDate                                            DateTime              @default(now())
  pin                                                 String                @unique @default("")
  pinLookup                                           String?               @unique
  locationId                                          String?
  createdAt                                           DateTime              @default(now())
  updatedAt                                           DateTime @updatedAt
  sessionVersion                                      Int                   @default(0)
  permissionOverrides                                 String                  @default("[]")
  BiometricCredential                                 BiometricCredential[]
  CashRegisterShift                                   CashRegisterShift[]
  DeliveryTracking                                    DeliveryTracking[]
  Location                                            Location?             @relation(fields: [locationId], references: [id], onUpdate: SetNull)
  EmployeeJob                                         EmployeeJob[]
  GoodsReceipt                                        GoodsReceipt[]
  GuestVisit                                          GuestVisit[]
  JournalEntry                                        JournalEntry[]
  KotDocument                                         KotDocument[]
  Order_Order_cancelledByIdToEmployee                 Order[]               @relation("Order_cancelledByIdToEmployee")
  Order_Order_employeeIdToEmployee                    Order[]               @relation("Order_employeeIdToEmployee")
  OrderItem                                           OrderItem[]
  PurchaseOrder_PurchaseOrder_approvedByIdToEmployee  PurchaseOrder[]       @relation("PurchaseOrder_approvedByIdToEmployee")
  PurchaseOrder_PurchaseOrder_requestedByIdToEmployee PurchaseOrder[]       @relation("PurchaseOrder_requestedByIdToEmployee")
  PushSubscription                                    PushSubscription[]
  StaffAvailability                                   StaffAvailability[]
  StaffShift_StaffShift_createdByIdToEmployee         StaffShift[]          @relation("StaffShift_createdByIdToEmployee")
  StaffShift_StaffShift_employeeIdToEmployee          StaffShift[]          @relation("StaffShift_employeeIdToEmployee")
  StockTransaction                                    StockTransaction[]
  TimeEntry                                           TimeEntry[]
  TimeOffRequest                                      TimeOffRequest[]
  TipDistribution                                     TipDistribution[]
  WaitlistEntry                                       WaitlistEntry[]
  ZReport                                             ZReport[]

  @@index([locationId])
  @@index([pin])
  @@index([role])
  @@index([status])
}

model EmployeeJob {
  id         String   @id
  employeeId String
  jobId      String
  payRate    Decimal  @default(0) 
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([employeeId, jobId])
  @@index([jobId])
}

model GiftCard {
  id                  String                @id
  cardNumber          String                @unique
  balance             Decimal               @default(0) 
  initialBalance      Decimal               @default(0) 
  status              String                @default("active")
  ownerName           String                @default("")
  purchasedAt         DateTime              @default(now())
  expiresAt           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime @updatedAt
  locationId          String?
  Location            Location?             @relation(fields: [locationId], references: [id])
  GiftCardTransaction GiftCardTransaction[]
  Payment             Payment[]

  @@index([expiresAt])
  @@index([locationId])
  @@index([status])
}

model GiftCardTransaction {
  id           String   @id
  giftCardId   String
  type         String
  amount       Decimal  
  balanceAfter Decimal  
  orderId      String?
  checkId      String?
  note         String   @default("")
  createdAt    DateTime @default(now())
  GiftCard     GiftCard @relation(fields: [giftCardId], references: [id])

  @@index([checkId])
  @@index([createdAt])
  @@index([giftCardId, createdAt])
  @@index([giftCardId])
  @@index([orderId])
  @@index([type])
}

model GoodsReceipt {
  id                String             @id
  grnNumber         String             @unique
  purchaseOrderId   String
  supplierId        String
  status            String             @default("confirmed")
  supplierDocNumber String             @default("")
  notes             String             @default("")
  receivedById      String?
  receivedByName    String             @default("")
  receivedAt        DateTime           @default(now())
  locationId        String?
  idempotencyKey    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime @updatedAt
  Location          Location?          @relation(fields: [locationId], references: [id], onUpdate: SetNull)
  PurchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  Employee          Employee?          @relation(fields: [receivedById], references: [id])
  Supplier          Supplier           @relation(fields: [supplierId], references: [id])
  GoodsReceiptItem  GoodsReceiptItem[]

  @@unique([purchaseOrderId, idempotencyKey])
  @@index([idempotencyKey])
  @@index([locationId])
  @@index([purchaseOrderId])
  @@index([receivedAt])
  @@index([supplierId])
}

model GoodsReceiptItem {
  id                  String             @id
  goodsReceiptId      String
  purchaseOrderItemId String?
  inventoryItemId     String?
  description         String
  unit                String             @default("pcs")
  quantityAccepted    Decimal            @default(0) 
  quantityRejected    Decimal            @default(0) 
  rejectReason        String             @default("")
  packQty             Decimal?           
  packUnit            String?
  unitPriceOrdered    Decimal            @default(0)
  createdAt           DateTime           @default(now())
  GoodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  PurchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

