# ─────────────────────────────────────────────────────────────────────────────
# RestavrantOS — .env.example (AUDIT-FIX v1.82.1: README navaja to datoteko,
# a ni obstajala v repozitoriju)
#
# Lokalni razvoj (SQLite):
#   cp .env.example .env
#   bun run db:push
#   bun run dev
#
# VSAK skrivni env (APP_SECRET, PIN_LOOKUP_SALT, BOOTSTRAP_*, FURS cert gesla,
# CRON_SECRET) nastavi NA VERCELU (Project → Settings → Environment Variables) —
# nikoli ne commitaj .env (gitignore ga varuje).
# ─────────────────────────────────────────────────────────────────────────────

# ── Baza ──
# Lokalni razvoj: SQLite datoteka (relativno na prisma/schema.sqlite.prisma)
DATABASE_URL="file:./db/dev.db"
# Produkcija (Vercel + Neon Postgres): postgresql://user:pass@host/db?sslmode=require

# ── Avtentikacija (OBVEZNO v produkciji — fail-closed, issue #4 §15) ──
# Skrivnost za podpis žetonov (HMAC-SHA256). V produkciji MORA biti nastavljena,
# sicer se aplikacija ne zažene. Generiraj: openssl rand -base64 48
APP_SECRET=""

# ── PIN indeks sol (AUDIT-FIX v1.82.1: priporočeno v produkciji) ──
# Sol za deterministični pinLookup (HMAC). Če ni nastavljjen v produkciji, se
# izvede iz APP_SECRET (varno, z glasnim opozorilom v logih). Nastavi eksplicitno
# za čisto rotacijsko sled — POZOR: rotacija spremeni pinLookup vrednosti
# (prijava še vedno deluje prek scrypt poti; glej src/lib/auth.ts).
PIN_LOOKUP_SALT=""

# ── Bootstrap admin (break-glass dostop — samo za obnovo) ──
# Nastavi SAMO začasno, kadar si izgubil dostop. 2-urni žeton, vloga ADMIN.
# Odstrani takoj po obnovi!
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PIN=""

# ── Vercel cron (/api/cron/daily — timing-safe Bearer CRON_SECRET ali admin seja) ──
# Generiraj: openssl rand -hex 32
CRON_SECRET=""

# ── FURS SI fiskalizacija (glej docs/FURS-CERT-RUNBOOK.md) ──
# test | prod
FURS_ENVIRONMENT="test"
FURS_ENDPOINT_URL=""
# Certifikat (base64 P12 vsebina) + geslo — NIKOLI v repozitorij
FURS_CERT_P=""
FURS_CERT_PASSWORD=""
# Lokalno simulacijo uporabi samo za razvoj
FURS_ALLOW_SIMULATION=""

# ── FINA HR fiskalizacija (pripravljeno na certifikat) ──
FURS_HR_ENVIRONMENT="test"
FURS_HR_ENDPOINT_URL=""
FURS_HR_CERT_P=""
FURS_HR_CERT_PASSWORD=""
FURS_HR_CA_PEM=""

# ── Upstash Redis (OPCIJNO — deljeni rate-limit čez instance, dormant brez env) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
