# ─────────────────────────────────────────────────────────────────────────────
# RestaurantOS — .env.example (AUDIT-FIX v1.82.1: README navaja to datoteko,
# a ni obstajala v repozitoriju)
#
# Lokalni razvoj (SQLite):
#   cp .env.example .env
#   bun run db:push
#   bun run dev
#
# VSAK skrivni env (APP_SECRET, PIN_LOOKUP_SALT, BOOTSTRAP_*, FURS cert gesla,
# CRON_SECRET) nastavi NA VERCELU (Project → Settings → Environment Variables) —
# nikoli ne commitaj .env (gitignore ga varuje).
# ─────────────────────────────────────────────────────────────────────────────

# ── Baza ──
# Lokalni razvoj: SQLite datoteka (relativno na prisma/schema.sqlite.prisma)
DATABASE_URL="file:./db/dev.db"
# Produkcija (Vercel + Neon Postgres): postgresql://user:pass@host/db?sslmode=require

# ── Avtentikacija (OBVEZNO v produkciji — fail-closed, issue #4 §15) ──
# Skrivnost za podpis žetonov (HMAC-SHA256). V produkciji MORA biti nastavljena,
# sicer se aplikacija ne zažene. Generiraj: openssl rand -base64 48
APP_SECRET=""

# ── PIN indeks sol (AUDIT-FIX v1.82.1: priporočeno v produkciji) ──
# Sol za deterministični pinLookup (HMAC). Če ni nastavljjen v produkciji, se
# izvede iz APP_SECRET (varno, z glasnim opozorilom v logih). Nastavi eksplicitno
# za čisto rotacijsko sled — POZOR: rotacija spremeni pinLookup vrednosti
# (prijava še vedno deluje prek scrypt poti; glej src/lib/auth.ts).
PIN_LOOKUP_SALT=""

# ── Bootstrap admin (break-glass dostop — samo za obnovo) ──
# Nastavi SAMO začasno, kadar si izgubil dostop. 2-urni žeton, vloga ADMIN.
# Odstrani takoj po obnovi!
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PIN=""

# ── Vercel cron (/api/cron/daily — timing-safe Bearer CRON_SECRET ali admin seja) ──
# Generiraj: openssl rand -hex 32
CRON_SECRET=""

# ── Demo vstop brez gesla (/api/auth/demo-login — issue #7, v1.148.0) ──
# Namenska vrata za čas RAZVOJA: prijavijo najstarejši aktivni vodstveni račun
# (owner/admin) brez MFA in brez vpisa poverilnic. Vsak vstop zapiše audit
# DEMO_LOGIN; rate-limit je 10/min po IP. MFA-zavarovanega računa NE obide.
# Privzeto (obe spremenljivki izpuščeni) so vrata ODPRTA BREZ ROKA — to je
# trenutna lastnikova odločitev, ne pozaba. Pred javno objavo aplikacije
# nastavi DEMO_LOGIN_EXPIRES_AT (ali zapri z DEMO_LOGIN_ENABLED=0).
# 0/false/no/off = vrata so takoj zaprta (403 DEMO_LOGIN_DISABLED).
DEMO_LOGIN_ENABLED=""
# ISO datum/čas (npr. 2026-12-31T23:59:00+01:00). Potekla ali NEVELJAVNA
# vrednost vrata ZAPRE (fail-closed: "nikoli ne poteče" ne sme biti posledica
# tipkarske napake). Prazno = brez roka.
DEMO_LOGIN_EXPIRES_AT=""
# Neobvezno: pripne demo vstop na TOČNO določen račun (e-pošta, mala tiskana).
# Če pripeti račun ne obstaja, ni vodstven ali ima MFA → 403.
# Ne nastavlja se samo od sebe.
DEMO_LOGIN_EMAIL=""

# ── FURS SI fiskalizacija (glej docs/FURS-CERT-RUNBOOK.md) ──
# production | test | simulation (veljavne vrednosti — typo = 503 fail-closed, issue #53)
# Globalni env ima PREDNOST pred Location.fursEnvironment (nastavitve lokacije).
# V PRODUKCIJI (NODE_ENV=production) velja fail-closed (issue #53):
#   - BREZ FURS_ENVIRONMENT in brez fursEnvironment lokacije → fiskalna izdaja
#     zavrnjena (503) — nikoli več privzeta simulacija z lažnim 'verified';
#   - FURS_ENVIRONMENT=simulation → zavrnjeno (503), razen ob izrecni odobritvi
#     FURS_PRODUCTION_TEST_MODE=true;
#   - FURS_ALLOW_SIMULATION=true OB FURS_ENVIRONMENT=production → zavrnjeno (503)
#     — zastavica ne sme PRISILITI simulacije nad produkcijskim okoljem; nad
#     izrecnim 'test' profilom je redundančna (dovoljena, priporočamo odstranitev).
FURS_ENVIRONMENT="test"
FURS_ENDPOINT_URL=""
# Certifikat (base64 P12 vsebina) + geslo — NIKOLI v repozitorij
# POMEMBNO (v1.144.0): ključ je FURS_CERT_P12_B64 (koda ga bere dobesedno —
# napačno ime enva je tiha produkcijska napaka: certifikat je "nameščen", izdaja
# pa ostaja 'pending' brez jasnega razloga).
FURS_CERT_P12_B64=""
FURS_CERT_PASSWORD=""
# CA veriga FURS strežnika (ACNP / PoCC), PEM ali base64 PEM — SIMETRIČNO
# FURS_HR_CA_PEM. Node ob nastavljenem `ca` ZAMENJA privzeti nabor korenin,
# zato podaj CELA veriga do korenine. Brez nje produkcija odpade z
# `self signed certificate` → 'pending' (fail-safe). Glej docs/FURS-CERT-RUNBOOK.md §2.
FURS_CA_PEM=""
# Lokalno simulacijo uporabi samo za razvoj — V PRODUKCIJI ob FURS_ENVIRONMENT=
# production je zastavica ZAVRNJENA; nad izrecnim 'test' profilom je redundančna
# (ne blokira izdaje, opozorilo v logih — priporočamo odstranitev).
FURS_ALLOW_SIMULATION=""
# Namenska varovalka (issue #53): 'true' = lastnik IZRECNO odobri simulacijski
# fiskalni način v produkcijskem runtime-u (izključno namenska odločitev — privzeto
# izpuščeno). V development/test runtime-u nima učinka.
FURS_PRODUCTION_TEST_MODE=""

# ── Kartična plačila — politika dokazovanja (issue #49, glej src/lib/payments-policy.ts) ──
# 'false' = ročna potrditev terminala (delavec prepisuje kodo z fizičnega terminala)
# je ONEMOGOČENA: brez strežniško preverjene ponudniške integracije se nad kartičnim/
# mobilnim plačilom NE izda račun. Privzeto (nezastavljeno) je ročni način DOVOLJEN
# (obstoječ POS postopek) — vedno pa je v audit zapisan profil 'manual_attestation'.
# Simulator (SIM- kode brskalniškega terminala) velja SAMO v simulacijskem okolju
# (FURS_ENVIRONMENT/Location.fursEnvironment) in je v produkciji ZAVRNJEN (402).
PAYMENTS_ALLOW_MANUAL_ATTESTATION=""

# ── Stripe Checkout — plačilne povezave + podpisani webhook (v1.157.0) ──
# STRIPE_SECRET_KEY omogoči Stripe Checkout na /pay/<token>; brez njega javna
# povezava ostane na simulatorju (vidno označen, v produkciji zavrnjen).
# STRIPE_WEBHOOK_SECRET je podpisna skrivnost endpointa
# https://<domena>/api/public/stripe/webhook (dogodka checkout.session.completed
# in checkout.session.async_payment_succeeded). Brez skrivnosti webhook vrača 503;
# namesto env se uporabi Integration(type='payments').config.webhookSecret.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── FINA HR fiskalizacija (pripravljeno na certifikat) ──
FURS_HR_ENVIRONMENT="test"
FURS_HR_ENDPOINT_URL=""
FURS_HR_CERT_P12_B64=""
FURS_HR_CERT_PASSWORD=""
FURS_HR_CA_PEM=""

# ── Upstash Redis (OPCIJNO — deljeni rate-limit čez instance, dormant brez env) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
