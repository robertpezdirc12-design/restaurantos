generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_URI")
}

model ApiKey {
  id              String       @id
  name            String
  keyHash         String       @unique
  keyPrefix       String
  createdBy       String?
  createdAt       DateTime     @default(now())
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  purpose         String?
  scopes          String       @default("projects:read,projects:write,measurements:create,photos:read,photos:write")
  projectScope    String?
  expiresAt       DateTime?
  rotatedFrom     String?
  rateLimitPerMin Int?
  SyncDevice      SyncDevice[]
}

model ArSnapshot {
  id          String   @id
  projectId   String
  profilId    String?
  imageUrl    String?
  tocke       String
  meritve     String?
  kalibracija String?
  opombe      String?
  createdAt   DateTime @default(now())
  mime        String?
  sha256      String?
  sizeBytes   Int?
  storageKey  String?
  Profil      Profil?  @relation(fields: [profilId], references: [id])
  Project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id
  userId    String?
  projectId String?
  akcija    String
  oldValue  String?
  newValue  String?
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
  Project   Project? @relation(fields: [projectId], references: [id])
  Profile   Profile? @relation(fields: [userId], references: [id])

  @@index([akcija, timestamp])
  @@index([projectId, timestamp])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model BOM {
  id         String       @id
  projectId  String       @unique
  status     String       @default("AKTIVEN")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  Project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  BOMVersion BOMVersion[]

  @@index([status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model BOMLine {
  id                     String                   @id
  bomVersionId           String
  lineOrder              Int
  quoteLineKey           String?
  internalSku            String
  supplierSku            String?
  inventoryId            String?
  category               String
  descriptionSnapshot    String
  quantity               Decimal                  @db.Decimal(12, 3)
  unit                   String
  wasteFactor            Decimal?                 @db.Decimal(6, 4)
  grossQuantity          Decimal?                 @db.Decimal(12, 3)
  unitCost               Decimal?                 @db.Decimal(12, 2)
  totalCost              Decimal?                 @db.Decimal(12, 2)
  supplierId             String?
  geometrySource         String?
  calculationRuleVersion String
  status                 String
  BOMVersion             BOMVersion               @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  Inventory              Inventory?               @relation(fields: [inventoryId], references: [id])
  Supplier               Supplier?                @relation(fields: [supplierId], references: [id])
  InstallationRecordLine InstallationRecordLine[]
  ProductionOrderLine    ProductionOrderLine[]

  @@index([bomVersionId])
  @@index([internalSku])
  @@index([inventoryId])
  @@index([supplierId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model BOMVersion {
  id                   String               @id
  bomId                String
  versionNumber        Int
  status               String
  sourceQuoteVersionId String
  priceBookVersionId   String
  productSdkVersion    String
  layoutFingerprint    String
  createdById          String?
  approvedById         String?
  createdAt            DateTime             @default(now())
  approvedAt           DateTime?
  BOMLine              BOMLine[]
  BOM                  BOM                  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  PriceBookVersion     PriceBookVersion     @relation(fields: [priceBookVersionId], references: [id])
  QuoteVersion         QuoteVersion         @relation(fields: [sourceQuoteVersionId], references: [id], onDelete: Cascade)
  InstallationRecord   InstallationRecord[]
  ProductionOrder      ProductionOrder[]

  @@unique([bomId, versionNumber])
  @@index([bomId])
  @@index([createdAt])
  @@index([priceBookVersionId])
  @@index([sourceQuoteVersionId])
  @@index([status])
}

model Crew {
  id                            String                 @id
  naziv                         String                 @unique
  vodjaId                       String?
  aktivna                       Boolean                @default(true)
  barva                         String                 @default("#1d2b3e")
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime
  Profile_Crew_vodjaIdToProfile Profile?               @relation("Crew_vodjaIdToProfile", fields: [vodjaId], references: [id])
  InstallationRecord            InstallationRecord[]
  InstallationSchedule          InstallationSchedule[]
  Nalog                         Nalog[]
  Profile_Profile_ekipaIdToCrew Profile[]              @relation("Profile_ekipaIdToCrew")

  @@index([aktivna])
}

model Customer {
  id              String            @id
  ime             String
  naslov          String
  telefon         String?
  email           String?
  createdAt       DateTime          @default(now())
  status          String            @default("AKTIVEN")
  kontaktnaOseba  String?
  opomnikDatum    DateTime?
  opomnikOpis     String?
  zadnjiKontakt   DateTime?
  opombeCRM       String?
  kategorija      String?
  CustomerAddress CustomerAddress[]
  Opportunity     Opportunity[]
  Project         Project[]
  Quote           Quote[]
  WarrantyCase    WarrantyCase[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model CustomerAddress {
  id         String   @id
  customerId String
  tip        String   @default("KONTAKTNI")
  naslov     String
  kraj       String?
  postnaSt   String?
  jePrivzet  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, tip])
}

model Document {
  id              String            @id
  projectId       String
  pdfUrl          String?
  signatureUrl    String?
  tipDokumenta    DocumentType      @default(TEHNICNI_LIST)
  status          String            @default("GENERIRANO")
  createdAt       DateTime          @default(now())
  sha256          String?
  storageKey      String?
  quoteVersionId  String?
  Project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  QuoteVersion    QuoteVersion?     @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  DocumentVersion DocumentVersion[]

  @@index([quoteVersionId])
}

model DocumentVersion {
  id             String        @id
  documentId     String
  version        Int
  storageKey     String
  mime           String        @default("application/pdf")
  sizeBytes      Int
  sha256         String
  createdAt      DateTime      @default(now())
  quoteVersionId String?
  Document       Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  QuoteVersion   QuoteVersion? @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
  @@index([quoteVersionId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model EngineeringRule {
  id                     String                   @id
  sifra                  String                   @unique
  naziv                  String
  kategorija             String
  aplikacija             String?
  productId              String?
  orientacija            String?
  aktivno                Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  Product                Product?                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  EngineeringRuleVersion EngineeringRuleVersion[]

  @@index([aplikacija])
  @@index([kategorija])
  @@index([productId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model EngineeringRuleVersion {
  id                String          @id
  ruleId            String
  verzija           Int
  status            String
  vsebina           String
  strukturaJson     String?
  vir               String
  virZapis          String?
  standardReferenca String?
  standardVerzija   String?
  jurisdikcija      String?
  overitev          String
  calculatorVerzija String?
  veljavnostOd      DateTime
  veljavnostDo      DateTime?
  reviewedAt        DateTime?
  reviewerId        String?
  createdById       String?
  createdAt         DateTime        @default(now())
  EngineeringRule   EngineeringRule @relation(fields: [ruleId], references: [id])

  @@unique([ruleId, verzija])
  @@index([overitev])
  @@index([ruleId, status])
  @@index([status])
  @@index([vir])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Equipment {
  id                     String                @id
  naziv                  String                @unique
  tip                    String
  sifra                  String?
  status                 String                @default("NA_VOLJO")
  lokacija               String?
  zadnjiServis           DateTime?
  opomba                 String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime
  serijskaStevilka       String?
  pridobitev             DateTime?
  lastInspectionAt       DateTime?
  inspectionIntervalDays Int?
  calibrationRequired    Boolean               @default(false)
  calibrationDueDate     DateTime?
  calibrationCertificate String?
  EquipmentAssignment    EquipmentAssignment[]
  EquipmentEvent         EquipmentEvent[]

  @@index([status])
}

model EquipmentAssignment {
  id                   String               @id
  scheduleId           String
  equipmentId          String
  datumOd              DateTime
  datumDo              DateTime
  opomba               String?
  createdAt            DateTime             @default(now())
  Equipment            Equipment            @relation(fields: [equipmentId], references: [id])
  InstallationSchedule InstallationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([scheduleId])
}

model EquipmentEvent {
  id            String    @id
  equipmentId   String
  type          String
  performedAt   DateTime
  result        String    @default("V_REDU")
  certificate   String?
  opomba        String?
  performedById String?
  createdAt     DateTime  @default(now())
  Equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  Profile       Profile?  @relation(fields: [performedById], references: [id])

  @@index([equipmentId, performedAt])
}

model GalleryItem {
  id              String   @id
  projectId       String?
  profilId        String?
  naslov          String
  opis            String?
  lokacija        String?
  slikaPred       String?
  slikaPo         String?
  javno           Boolean  @default(false)
  createdAt       DateTime @default(now())
  slikaPoKey      String?
  slikaPoMime     String?
  slikaPoSha256   String?
  slikaPoSize     Int?
  slikaPredKey    String?
  slikaPredMime   String?
  slikaPredSha256 String?
  slikaPredSize   Int?
  Profil          Profil?  @relation(fields: [profilId], references: [id])
  Project         Project? @relation(fields: [projectId], references: [id])
}

model IdempotencyKey {
  key            String   @id
  route          String
  profileId      String?
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model InstallationEvidence {
  id                                                            String                 @id
  projectId                                                     String
  scheduleId                                                    String?
  templateVersion                                               String
  lokacija                                                      String
  beforePhotoId                                                 String?
  afterPhotoId                                                  String?
  gpsLat                                                        Float?
  gpsLng                                                        Float?
  gpsConsentAt                                                  DateTime?
  checklistJson                                                 String
  measurementId                                                 String?
  defectsJson                                                   String
  handoverName                                                  String?
  handoverAt                                                    DateTime?
  note                                                          String?
  createdById                                                   String?
  createdAt                                                     DateTime               @default(now())
  updatedAt                                                     DateTime
  nalogId                                                       String?
  ProjectPhoto_InstallationEvidence_afterPhotoIdToProjectPhoto  ProjectPhoto?          @relation("InstallationEvidence_afterPhotoIdToProjectPhoto", fields: [afterPhotoId], references: [id])
  ProjectPhoto_InstallationEvidence_beforePhotoIdToProjectPhoto ProjectPhoto?          @relation("InstallationEvidence_beforePhotoIdToProjectPhoto", fields: [beforePhotoId], references: [id])
  Profile                                                       Profile?               @relation(fields: [createdById], references: [id])
  Measurement                                                   Measurement?           @relation(fields: [measurementId], references: [id])
  Nalog                                                         Nalog?                 @relation(fields: [nalogId], references: [id])
  Project                                                       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  InstallationSchedule                                          InstallationSchedule?  @relation(fields: [scheduleId], references: [id])
  InstallationRecord                                            InstallationRecord[]
  WarrantyCase                                                  WarrantyCase[]
  WarrantyServiceVisit                                          WarrantyServiceVisit[]

  @@index([nalogId])
  @@index([projectId, createdAt])
  @@index([scheduleId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model InstallationRecord {
  id                     String                   @id
  projectId              String
  scheduleId             String?
  productionOrderId      String?
  crewId                 String?
  monterId               String?
  bomVersionId           String
  startedAt              DateTime?
  completedAt            DateTime?
  versionNumber          Int
  status                 String                   @default("DRAFT")
  defectsJson            String                   @default("[]")
  reworkNote             String?
  qcId                   String?
  evidenceId             String?
  handoverName           String?
  handoverAt             DateTime?
  actualMeasurementsJson String?
  createdById            String?
  approvedById           String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  approvedAt             DateTime?
  BOMVersion             BOMVersion               @relation(fields: [bomVersionId], references: [id])
  Crew                   Crew?                    @relation(fields: [crewId], references: [id])
  InstallationEvidence   InstallationEvidence?    @relation(fields: [evidenceId], references: [id])
  Profile                Profile?                 @relation(fields: [monterId], references: [id])
  ProductionOrder        ProductionOrder?         @relation(fields: [productionOrderId], references: [id])
  Project                Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  QualityControl         QualityControl?          @relation(fields: [qcId], references: [id])
  InstallationSchedule   InstallationSchedule?    @relation(fields: [scheduleId], references: [id])
  InstallationRecordLine InstallationRecordLine[]
  WarrantyCase           WarrantyCase[]

  @@unique([projectId, versionNumber])
  @@index([bomVersionId])
  @@index([productionOrderId])
  @@index([projectId])
  @@index([scheduleId])
  @@index([status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model InstallationRecordLine {
  id                   String             @id
  installationRecordId String
  bomLineId            String?
  internalSku          String
  installedQty         Decimal            @db.Decimal(12, 3)
  unit                 String
  wasteQty             Decimal?           @db.Decimal(12, 3)
  note                 String?
  BOMLine              BOMLine?           @relation(fields: [bomLineId], references: [id], onDelete: Restrict)
  InstallationRecord   InstallationRecord @relation(fields: [installationRecordId], references: [id], onDelete: Cascade)

  @@index([bomLineId])
  @@index([installationRecordId])
}

model InstallationSchedule {
  id                   String                 @id
  projectId            String
  crewId               String?
  monterId             String?
  datumZacetka         DateTime
  datumKonca           DateTime
  status               String                 @default("NAVRTENO")
  predvideneUre        Int                    @default(8)
  dejanskeUre          Int?
  opombe               String?
  lokacija             String?
  gpsLat               Float?
  gpsLon               Float?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  EquipmentAssignment  EquipmentAssignment[]
  InstallationEvidence InstallationEvidence[]
  InstallationRecord   InstallationRecord[]
  Crew                 Crew?                  @relation(fields: [crewId], references: [id])
  Profile              Profile?               @relation(fields: [monterId], references: [id])
  Project              Project                @relation(fields: [projectId], references: [id])
  QualityControl       QualityControl[]

  @@index([crewId])
  @@index([datumZacetka])
  @@index([status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Inventory {
  id                String              @id
  sifraMateriala    String              @unique
  naziv             String
  tip               String
  kolicinaZaloga    Decimal             @default(0) @db.Decimal(12, 3)
  enota             String
  minimalnaZaloga   Decimal             @default(5) @db.Decimal(12, 3)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  purchaseUnit      String?
  stockUnit         String?
  consumptionUnit   String?
  supplierPackSize  Decimal?            @db.Decimal(12, 3)
  conversionFactor  Decimal?            @db.Decimal(12, 6)
  precision         Int?
  rounding          String?
  BOMLine           BOMLine[]
  InventoryLot      InventoryLot[]
  InventoryMovement InventoryMovement[]
  MaterialOrderItem MaterialOrderItem[]
  MaterialPrice     MaterialPrice[]
  MaterialUsage     MaterialUsage[]
  StockLedger       StockLedger[]
}

model InventoryLot {
  id                String             @id
  inventoryId       String
  lotNumber         String
  supplierId        String?
  orderId           String?
  orderItemId       String?
  deliveryDate      DateTime           @default(now())
  purchasePrice     Decimal?           @db.Decimal(12, 2)
  quantityInitial   Decimal            @db.Decimal(12, 3)
  quantityRemaining Decimal            @db.Decimal(12, 3)
  status            String             @default("ACTIVE")
  note              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  Inventory         Inventory          @relation(fields: [inventoryId], references: [id])
  MaterialOrder     MaterialOrder?     @relation(fields: [orderId], references: [id])
  MaterialOrderItem MaterialOrderItem? @relation(fields: [orderItemId], references: [id])
  Supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  LotAllocation     LotAllocation[]
  StockLedger       StockLedger[]

  @@unique([inventoryId, lotNumber])
  @@index([deliveryDate])
  @@index([inventoryId, status])
  @@index([orderId])
  @@index([supplierId])
}

model InventoryMovement {
  id          String    @id
  inventoryId String
  projectId   String?
  orderId     String?
  kolicina    Decimal   @db.Decimal(12, 3)
  tipPremika  String
  createdAt   DateTime  @default(now())
  createdBy   String?
  Inventory   Inventory @relation(fields: [inventoryId], references: [id])
  Project     Project?  @relation(fields: [projectId], references: [id])

  @@index([orderId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Invoice {
  id                String              @id
  projectId         String
  tip               String              @default("RACUN")
  stevilka          String              @unique
  datumIzdaje       DateTime            @default(now())
  datumStoritve     DateTime?
  rokPlacilaDni     Int                 @default(8)
  status            String              @default("OSNUTEK")
  placanoAt         DateTime?
  postavke          String
  kupec             String?
  osnova            Decimal             @default(0) @db.Decimal(12, 2)
  ddv               Decimal             @default(0) @db.Decimal(12, 2)
  znesek            Decimal             @default(0) @db.Decimal(12, 2)
  opombe            String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  poslanoAt         DateTime?
  Project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Payment           Payment[]
  PaymentAllocation PaymentAllocation[]
  WarrantyCase      WarrantyCase[]

  @@index([projectId])
  @@index([projectId, status])
  @@index([status])
}

model JobRun {
  id             String    @id
  type           String
  owner          String
  input          String?
  status         String
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?
  correlationId  String
  idempotencyKey String    @unique
  result         String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?

  @@index([createdAt])
  @@index([type, createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Lead {
  id               String        @id
  source           String        @default("DRUGO")
  ime              String
  telefon          String?
  email            String?
  tipPovprasevanja String        @default("DRUGO")
  status           String        @default("NOV")
  ownerId          String?
  nextActionAt     DateTime?
  opombe           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  Profile          Profile?      @relation(fields: [ownerId], references: [id])
  Opportunity      Opportunity[]

  @@index([ownerId])
  @@index([status, nextActionAt])
}

model LotAllocation {
  id           String       @id
  lotId        String
  ledgerId     String?
  eventType    String
  kolicina     Decimal      @db.Decimal(12, 3)
  projectId    String?
  actorId      String?
  createdAt    DateTime     @default(now())
  StockLedger  StockLedger? @relation(fields: [ledgerId], references: [id])
  InventoryLot InventoryLot @relation(fields: [lotId], references: [id])
  Project      Project?     @relation(fields: [projectId], references: [id])

  @@index([ledgerId])
  @@index([lotId, createdAt])
  @@index([projectId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MaterialOrder {
  id                String              @id
  projectId         String?
  supplierId        String
  status            String              @default("OSNUTEK")
  skupajCena        Decimal             @default(0) @db.Decimal(12, 2)
  datumNarocila     DateTime            @default(now())
  datumDobave       DateTime?
  opombe            String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  InventoryLot      InventoryLot[]
  Project           Project?            @relation(fields: [projectId], references: [id])
  Supplier          Supplier            @relation(fields: [supplierId], references: [id])
  MaterialOrderItem MaterialOrderItem[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MaterialOrderItem {
  id            String         @id
  orderId       String
  inventoryId   String
  kolicina      Decimal        @db.Decimal(12, 3)
  cena          Decimal        @db.Decimal(12, 2)
  naziv         String
  enota         String
  createdAt     DateTime       @default(now())
  InventoryLot  InventoryLot[]
  Inventory     Inventory      @relation(fields: [inventoryId], references: [id])
  MaterialOrder MaterialOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
model MaterialPrice {
  id           String    @id
  inventoryId  String
  supplierId   String
  cena         Decimal   @db.Decimal(12, 2)
  veljavnostOd DateTime  @default(now())
  veljavnostDo DateTime?
  opomba       String?
  createdAt    DateTime  @default(now())
  Inventory    Inventory @relation(fields: [inventoryId], references: [id])
  Supplier     Supplier  @relation(fields: [supplierId], references: [id])

  @@index([inventoryId, supplierId])
  @@index([veljavnostOd])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MaterialUsage {
  id                 String    @id
  projectId          String
  inventoryId        String
  porabljenaKolicina Decimal   @db.Decimal(12, 3)
  datumVpisa         DateTime  @default(now())
  Inventory          Inventory @relation(fields: [inventoryId], references: [id])
  Project            Project   @relation(fields: [projectId], references: [id])
}

model Measurement {
  id                   String                 @id
  projectId            String
  dolzinaMm            Int
  visinaMm             Int
  lidarScanUrl         String?
  arMetadata           String?
  gpsLokacija          String?
  createdAt            DateTime               @default(now())
  createdBy            String?
  dedupeHash           String?
  status               String                 @default("OSNUTEK")
  statusNote           String?
  statusUpdatedAt      DateTime?
  verzija              Int?
  predhodnikId         String?                @unique
  korenId              String?
  vir                  String?
  InstallationEvidence InstallationEvidence[]
  Measurement          Measurement?           @relation("MeasurementToMeasurement", fields: [predhodnikId], references: [id])
  other_Measurement    Measurement?           @relation("MeasurementToMeasurement")
  Project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([korenId, verzija])
  @@index([projectId, dedupeHash])
  @@index([projectId, status])
  @@index([projectId, verzija])
}

model Nalog {
  id                   String                 @id
  projectId            String
